# Free Groq API key — https://console.groq.com/keys (optional)
# Without it, PipelineForge still runs using statistical + rule-based agents.
GROQ_API_KEY=

# Model on Groq free tier
GROQ_MODEL=llama-3.1-8b-instant

# Local embedding model (downloaded once, no billing)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2